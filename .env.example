# RAGInGoa – Environment Variables

# Sarvam AI API subscription key for Speech-to-Text
SARVAM_API_KEY=your_sarvam_api_key_here

# Gemini API Key for Grounded Generation
GEMINI_API_KEY=your_gemini_api_key_here

# Dataset configuration
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_SPLIT=validation
DATASET_LANGUAGE=hin_Deva
MAX_DATASET_ITEMS=1000

# Embedding model configuration
# (e.g., sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2, sentence-transformers/LaBSE)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Vector store configuration
FAISS_INDEX_PATH=./data/faiss_index

# Chunking configuration
CHUNKER_STRATEGY=fixed_size
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval configuration
RETRIEVAL_TOP_K=3
